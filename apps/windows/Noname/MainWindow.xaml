<Window x:Class="Noname.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Noname" Height="720" Width="1200" Background="#0F172A">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock FontSize="28" FontWeight="Bold" Text="Noname" />
      <TextBlock Margin="16,0,0,0" FontSize="16" Text="Estado: " />
      <TextBlock FontSize="16" Text="{Binding CurrentState}" Foreground="{StaticResource AccentBrush}" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,24,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,24,0" Spacing="12">
        <Border Background="#111827" CornerRadius="16" Padding="16">
          <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Temporizador" />
            <TextBlock FontSize="48" FontWeight="Bold" Text="{Binding TimerDisplay}" />
            <Button Content="Pánico: bloquear ya" Margin="0,8,0,0" Click="OnPanic" />
          </StackPanel>
        </Border>

        <Border Background="#111827" CornerRadius="16" Padding="16">
          <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Vincular móvil" />
            <TextBlock Text="Código:" />
            <TextBlock FontSize="24" FontWeight="Bold" Text="{Binding PairCode}" />
            <Image Height="160" Width="160" Source="{Binding PairQr}" />
            <Button Content="Generar código" Margin="0,8,0,0" Click="OnGeneratePair" />
          </StackPanel>
        </Border>

        <Border Background="#111827" CornerRadius="16" Padding="16">
          <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Enrollment" />
            <TextBlock Text="Registra 3 selfies para crear embeddings locales." />
            <Button Content="Registrar selfies" Margin="0,8,0,0" Click="OnEnroll" />
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="12">
        <Border Background="#111827" CornerRadius="16" Padding="16">
          <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Puntos" />
            <TextBlock FontSize="32" FontWeight="Bold" Text="{Binding Points}" />
            <TextBlock Text="Minutos disponibles: " />
            <TextBlock FontSize="24" Text="{Binding MinutesAvailable}" />
          </StackPanel>
        </Border>

        <Border Background="#111827" CornerRadius="16" Padding="16">
          <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Bloqueo de webs" />
            <ListBox ItemsSource="{Binding BlockedDomains}" Height="140" />
            <TextBox Name="DomainInput" Margin="0,8,0,0" />
            <Button Content="Agregar dominio" Click="OnAddDomain" />
          </StackPanel>
        </Border>

        <Border Background="#111827" CornerRadius="16" Padding="16">
          <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Ranking global" />
            <ListBox ItemsSource="{Binding Leaderboard}" Height="160" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
